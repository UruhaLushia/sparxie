# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust core
/core/target/
/android/app/src/main/jniLibs

# flutter_rust_bridge generated bindings are committed. They are required by
# normal `cargo build` / `flutter build` unless codegen is run first.

# build_runner generated sources (freezed, json_serializable, etc.)
*.freezed.dart
*.g.dart
!/lib/src/rust/**/*.freezed.dart

# VS Code Dart extension scratch
/devtools_options.yaml
